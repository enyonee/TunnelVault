FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    tini \
    openvpn \
    openfortivpn \
    openconnect \
    wireguard-tools \
    strongswan \
    strongswan-swanctl \
    strongswan-charon \
    strongswan-starter \
    libstrongswan \
    libstrongswan-standard-plugins \
    libcharon-extauth-plugins \
    strongswan-libcharon \
    iproute2 \
    iptables \
    dnsutils \
    net-tools \
    iputils-ping \
    curl \
    netcat-openbsd \
    procps \
    sudo \
    sshpass \
    sshuttle \
    && rm -rf /var/lib/apt/lists/*

# tailscale
RUN curl -fsSL https://tailscale.com/install.sh | sh

# sing-box
RUN curl -Lo /tmp/sing-box.tar.gz \
    "https://github.com/SagerNet/sing-box/releases/download/v1.11.0/sing-box-1.11.0-linux-amd64.tar.gz" \
    && tar -xzf /tmp/sing-box.tar.gz -C /tmp \
    && mv /tmp/sing-box-*/sing-box /usr/local/bin/ \
    && rm -rf /tmp/sing-box*

WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN pip install uv && uv sync --group dev --no-install-project

COPY . .
RUN uv sync --group dev

# Bake shared configs for integration tests
RUN mkdir -p /shared \
    && cp tests/e2e/pki/client.ovpn /shared/client.ovpn \
    && cp tests/e2e/pki/ocserv-fingerprint.txt /shared/ocserv-fingerprint

COPY tests/e2e/test-runner-entrypoint.sh /test-runner-entrypoint.sh
RUN chmod +x /test-runner-entrypoint.sh

ENTRYPOINT ["tini", "--", "/test-runner-entrypoint.sh"]
CMD ["uv", "run", "pytest", "tests/integration/", "-x", "-v", "--tb=short", "-o", "addopts=", "-p", "no:xdist"]
