FROM python:3.12-slim

RUN pip install --no-cache-dir flask

# Generate self-signed cert for HTTPS
RUN openssl req -x509 -newkey rsa:2048 -keyout /cert.key -out /cert.pem \
    -days 365 -nodes -subj "/CN=fake-fortinet"

COPY tests/e2e/fake-fortinet-server.py /server.py

EXPOSE 4443

CMD ["python3", "/server.py", "0.0.0.0", "4443", "/cert.pem", "/cert.key"]
